{% comment %} Card-style media list rendering {% endcomment %}
<div class="card card-sm bg-base-100">
  <div class='card-body'>
    <div class="flex items-center space-x-2 text-xs font-light">
      {%- if page.published_at -%}
        <div class="flex items-center space-x-1 text-base-content/50">
          <i data-lucide="calendar-clock" class="h-4 w-4"></i>
          <span class="flex items-center justify-center text-xs font-mono">{{ page.published_at | date: "%Y-%m-%d" }}</span>
        </div>
      {%- endif -%}

      {% for tag in page.settings.tags %}
        {% render 'tag', tag: tag %}
      {% endfor %}
    </div>
    <a class='text-md text-base-content font-bold hover:underline md:text-2xl' href="{{ page.path }}">{{ page.link_text }}</a>

    {% assign thumb_image_url = page.settings.thumb_image_url | presence %}
    {%- if thumb_image_url -%}
      <div class="overflow-hidden rounded-lg bg-primary/10">
        <a href="{{ page.path }}" class="block">
          <img class="w-full transition-all duration-500 ease-in-out scale-100 hover:scale-110" src="{{ thumb_image_url }}" />
        </a>
      </div>
    {%- endif  -%}

    <p class="leading-normal text-base-content/75">{{ page.settings.description }}</p>

    {% comment %} {%- render "feedback_form", page: page -%} {% endcomment %}
    {%- render "sub_page_list", page: page, per: 5 -%}
  </div>
</div>