{% comment %} List rows for index.list — glass card on light shell {% endcomment %}
<article class="partners-glass-card flex justify-between gap-4 border-base-300/80 px-4 py-4 transition hover:border-primary/40">
  <div class="min-w-0 flex-1">
    <a href="{{ page.path }}" class="flex items-start">
      <div class="mr-3 mt-2 shrink-0">
        <i data-lucide="file-stack" class="h-4 w-4 shrink-0 text-primary"></i>
      </div>
      <h2 class="text-lg font-bold leading-snug text-base-content hover:text-primary hover:underline md:text-xl">{{
        page.link_text }}</h2>
    </a>
    <div class="pl-7">
      {% assign desc = page.settings.description | default: page.settings.tagline %}
      {% if desc != blank %}
        <div class="mt-1 text-sm text-base-content/70">{{ desc }}</div>
      {% endif %}
      <ul class="mt-2 flex flex-wrap gap-x-2">
        {% for tag in page.tags %}
          <li class="flex items-center text-sm after:px-2 after:text-base-content/40 after:content-['·'] last:after:content-['']">
            <a class="font-semibold text-primary hover:underline" href="{{ tag.path }}">{{ tag.name }}</a>
          </li>
        {% endfor %}
      </ul>
      {% render "sub_page_list", page: page, per: 5 %}
    </div>
  </div>
  {% assign page_thumb_image_url = page.settings.thumb_image_url | default: page.settings.logo_image_url | presence %}
  {% if page_thumb_image_url %}
    <div class="shrink-0">
      <img class="max-h-24 rounded-lg ring-1 ring-base-300/80" src="{{ page_thumb_image_url }}" alt="" loading="lazy" />
    </div>
  {% endif %}
</article>
