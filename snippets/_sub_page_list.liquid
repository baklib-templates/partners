{% comment %} Child page list under an article {% endcomment %}
{%- assign page_per = per | default: 15 -%}
{%- assign sub_pages = page.children_in_list | order_by: '-created_at' | limit: page_per %}
{%- assign sub_pages_count = page.children_in_list | size -%}

{%- if sub_pages_count > 0 -%}
  <ul class="mt-1 space-y-1 overflow-hidden list-none rounded">
    {% for page in sub_pages %}
      <li class="group rounded bg-base-200 hover:bg-primary/10">
        <a href="{{ page.path }}" class="flex items-center py-1.5 px-2 space-x-4">
          <h3 class="flex-grow w-0 truncate group-hover:text-primary">{{ page.link_text }}</h3>
          <span class="inline-block w-0 h-0 border-[5px] border-l-primary border-t-transparent border-r-transparent border-b-transparent flex-shrink-0"></span>
        </a>
      </li>
    {% endfor %}
  </ul>
{%- endif -%}
