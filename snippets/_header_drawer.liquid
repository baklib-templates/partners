<div class="drawer drawer-end w-[40px] items-end md:hidden">
  <input id="header-drawer-right" type="checkbox" class="drawer-toggle" x-init="$el.checked = false;" />
  <div class="drawer-content">
    <label for="header-drawer-right" class="drawer-button btn btn-ghost text-base-content/80">
      <i data-lucide="menu" class="size-6"></i>
    </label>
  </div>
  <div class="drawer-side">
    <label
      for="header-drawer-right"
      aria-label="close sidebar"
      class="drawer-overlay"
    ></label>
    <div class="bg-base-200 text-base-content min-h-full w-80 p-4">
      {% render 'sidebar', site: site %}
    </div>
  </div>
</div>
