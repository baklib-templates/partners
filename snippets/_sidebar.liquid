<div class="space-y-4">
  {% form_tag 'search' %}
    <label class="input">
      <i data-lucide="search" class="h-[1em] opacity-50"></i>
      <input type="search" class="grow" name="{{form.keywords_field_name}}" value="{{ search.keywords | escape }}" placeholder="{{ 'generic.placeholders.search' | t }}" />
    </label>
  {% endform_tag %}

  {%- assign header_menu_html = site.settings.header_menu_html -%}
  {% if header_menu_html %}
    <div class='card bg-base-100 p-4'>
      <label class="mb-3 block font-mono text-xs font-semibold text-base-content/60">MENU</label>
      <div class="space-y-2 flex flex-col pt-2 underline">
        {{ header_menu_html }}
      </div>
    </div>
  {% endif %}


  {%- assign tags = site.tags -%}
  {%- assign tags_count = tags | size -%}

  {% if tags_count > 0 %}
    <div class='card bg-base-100 p-4'>
      <label class="mb-3 block font-mono text-xs font-semibold text-base-content/60">TAGS</label>
      <ul role="list" class="flex flex-col">
        {% for tag in site.tags %}
          <li >
            <a
              href="{{ tag.path }}"
              style="--tag-color: {{ tag.color }};"
              class="flex items-center py-1.5 space-x-2 transition-all duration-300 ease-in-out"
            >
              <span class="w-2 h-2 rounded-full shrink-0" style="background-color: {{ tag.color }};"></span>
              <span class="flex-grow break-words text-base-content/70 hover:text-[var(--tag-color)]">
                {{ tag.name }}
              </span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}
</div>