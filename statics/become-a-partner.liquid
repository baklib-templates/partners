{% assign _become_meta_title = 'partners.become_partner' | t | strip %}
{% set_meta_title _become_meta_title %}
{% assign can_feedback = false %}
{% assign fb_first_emoji = '' %}
{% if site.settings.is_allow_feedback and site.plugins.feedback %}
  {% assign fb_types = site.plugins.feedback.useful_types %}
  {% assign fb_types_size = fb_types | size %}
  {% if fb_types_size > 0 and site.plugins.feedback.message_enabled %}
    {% assign ut0 = fb_types | first %}
    {% assign fb_first_emoji = ut0.emoji %}
    {% assign can_feedback = true %}
  {% endif %}
{% endif %}

<div class="container relative z-10 pb-20 pt-8">
  {% if can_feedback %}
    <div id="js--feedback-{{ page.id }}" class="hidden" aria-hidden="true"></div>
  {% endif %}
  <div class="grid gap-6 lg:grid-cols-2 lg:gap-8">
    <section class="partners-glass-card p-6 sm:p-8">
      <h1 class="text-2xl font-bold text-base-content">{{ 'partners.become_partner' | t }}</h1>
      <p class="mt-2 text-sm text-base-content/70">{{ 'partners.become_partner_sub' | t }}</p>

      <div class="mt-8">
        {% if can_feedback %}
          {% form_tag 'feedback', page: page %}
            <input type="hidden" name="{{ form.feedback_emoji_field_name }}" value="{{ fb_first_emoji | escape_once }}" />
            <div class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-base-content/80">{{ 'partners.form_company' | t }}</label>
                <input type="text" name="partner_company" class="input input-bordered mt-1 w-full border-base-300 bg-base-100" autocomplete="organization" />
              </div>
              <div>
                <label class="block text-sm font-medium text-base-content/80">{{ 'partners.form_intent' | t }}</label>
                <textarea name="partner_intent" rows="4" class="textarea textarea-bordered mt-1 w-full border-base-300 bg-base-100"></textarea>
              </div>
              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <label class="block text-sm font-medium text-base-content/80">{{ 'partners.form_email' | t }}</label>
                  <input type="email" name="partner_email" class="input input-bordered mt-1 w-full border-base-300 bg-base-100" autocomplete="email" />
                </div>
                <div>
                  <label class="block text-sm font-medium text-base-content/80">{{ 'partners.form_phone' | t }}</label>
                  <input type="tel" name="partner_phone" class="input input-bordered mt-1 w-full border-base-300 bg-base-100" autocomplete="tel" />
                </div>
              </div>
              <fieldset class="fieldset">
                <legend class="fieldset-legend text-sm font-medium text-base-content/80">{{ 'snippets.feedback_form.message_label' | t }}</legend>
                <textarea
                  name="{{ form.feedback_message_field_name }}"
                  rows="8"
                  required
                  class="textarea textarea-bordered mt-1 w-full min-h-[8rem] border-base-300 bg-base-100 text-sm leading-relaxed"
                  placeholder="{{ 'partners.form_feedback_placeholder' | t }}"
                ></textarea>
                <p class="mt-1 text-xs text-base-content/60">{{ 'partners.form_feedback_hint' | t }}</p>
              </fieldset>
            </div>
            <div class="mt-6">
              <button type="submit" class="btn btn-primary w-full sm:w-auto">{{ 'partners.form_submit_feedback' | t }}</button>
            </div>
          {% endform_tag %}
        {% else %}
          <p class="rounded-lg border border-warning/40 bg-warning/10 px-3 py-2 text-xs text-base-content">{{ 'partners.form_feedback_unavailable' | t }}</p>
        {% endif %}
      </div>
    </section>

    <aside class="partners-glass-card flex min-h-[360px] items-center justify-center p-6 sm:p-8">
      <div class="flex w-full max-w-md flex-col items-center gap-4 rounded-2xl border border-dashed border-base-300 bg-base-200/70 p-8 text-center">
        <i data-lucide="image-plus" class="h-10 w-10 text-base-content/50"></i>
        <p class="text-sm font-medium text-base-content/80">Image Placeholder</p>
        <p class="text-xs text-base-content/60">Replace this block with partner program visual.</p>
      </div>
    </div>
  </div> 
</div>
