          </section>
        </div>

        <div class="space-y-4 lg:col-span-4">
          <aside class="partners-glass-card sticky top-[calc(var(--header-height)+1rem)] flex h-[min(70vh,42rem)] flex-col overflow-hidden p-0">
            <header class="flex items-center justify-between border-b border-base-300/80 px-4 py-3">
              <div class="flex items-center gap-2">
                <span class="inline-block h-2 w-2 rounded-full bg-success"></span>
                <h2 class="text-sm font-semibold text-base-content">AI Assistant</h2>
              </div>
              <button class="btn btn-ghost btn-xs text-base-content/70"><i data-lucide="ellipsis" class="h-4 w-4"></i></button>
            </header>

            <div class="no-scrollbar flex-1 space-y-4 overflow-y-auto p-4 text-sm">
              <div class="max-w-[85%] space-y-1">
                <div class="rounded-2xl rounded-tl-sm border border-base-300 bg-base-200 px-3 py-2 text-base-content">Hi Sabina! I've analyzed the new partner data. Would you like to see growth projections for Q4?</div>
                <span class="pl-1 text-xs text-base-content/50">10:42 AM</span>
              </div>

              <div class="ml-auto max-w-[85%] space-y-1 text-right">
                <div class="rounded-2xl rounded-tr-sm bg-primary px-3 py-2 text-primary-content">Yes, please. Also show the latest MDF requests from EMEA.</div>
                <span class="pr-1 text-xs text-base-content/50">10:45 AM</span>
              </div>

              <div class="max-w-[85%] rounded-2xl rounded-tl-sm border border-base-300 bg-base-200 px-3 py-2 text-base-content">
                <p>Generating report...</p>
                <div class="mt-2 flex items-center gap-1 text-base-content/60">
                  <span class="h-1.5 w-1.5 rounded-full bg-primary/70"></span>
                  <span class="h-1.5 w-1.5 rounded-full bg-primary/50"></span>
                  <span class="h-1.5 w-1.5 rounded-full bg-primary/35"></span>
                </div>
              </div>
            </div>

            <footer class="border-t border-base-300/80 p-4">
              <label class="input input-bordered flex items-center gap-2 border-base-300 bg-base-100">
                <input type="text" class="grow" placeholder="Type a message..." />
                <button class="btn btn-ghost btn-xs px-1 text-primary"><i data-lucide="send" class="h-4 w-4"></i></button>
              </label>
              <div class="mt-3 flex flex-wrap gap-2">
                <button class="btn btn-xs btn-soft">Show Analytics</button>
                <button class="btn btn-xs btn-soft">Open Tasks</button>
              </div>
            </footer>
          </aside>
        </div>
      </section>

      <section class="partners-glass-card flex flex-col items-center gap-4 p-6 sm:flex-row sm:justify-between">
        <div class="flex items-center gap-3">
          <div class="avatar-group -space-x-3">
            <div class="avatar">
              <div class="h-12 w-12">
                <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuDoSR5DnYyplH_fEp_QMAxIAwztQp27bg-7Nrk9yw9gWdxy7JoTYrK13KB0pGaiKte44FzRjwhn-BFUUOPqSgsI5-OnpXz3VGSBr3BGX6gmANZMYeH-gWRFiDtBGPqh1ARc1tDDEi1Dl79QAuQxxXARCOLRowXJlErdEjHju2fLhqg_JfP5ky1MepVaYZbELZ23omuT_EsutFNnhYTlmFWl_mVGeIkSnhPgvNoAfSexkYeoe9Wz88vJYKeDl2iJLNUGcbLJ5sodTEM" alt="Top performer 1" />
