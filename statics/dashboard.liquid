                <i data-lucide="folder-open" class="h-4 w-4 text-base-content/60"></i>
              </div>
              <label class="input input-bordered mt-3 h-10 border-base-300 bg-base-100">
                <i data-lucide="search" class="h-4 w-4 text-base-content/50"></i>
                <input type="text" class="grow" placeholder="Search onboarding forms" />
              </label>
              <div class="mt-3 grid grid-cols-2 gap-2">
                <a href="{{ resources_url }}" class="rounded-lg bg-primary/80 px-3 py-3 text-xs font-medium text-primary-content transition-colors hover:bg-primary">Compliance</a>
                <a href="{{ resources_url }}" class="rounded-lg bg-info px-3 py-3 text-xs font-medium text-info-content transition-colors hover:bg-info/80">Job Descriptions</a>
                <a href="{{ resources_url }}" class="rounded-lg bg-secondary px-3 py-3 text-xs font-medium text-secondary-content transition-colors hover:bg-secondary/80">Legal</a>
                <a href="{{ resources_url }}" class="rounded-lg bg-accent px-3 py-3 text-xs font-medium text-accent-content transition-colors hover:bg-accent/80">Performance</a>
                <a href="{{ resources_url }}" class="rounded-lg bg-neutral px-3 py-3 text-xs font-medium text-neutral-content transition-colors hover:bg-neutral/80">Training</a>
