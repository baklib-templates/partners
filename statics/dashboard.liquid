                  <div class="p-3">
                    <h3 class="line-clamp-1 text-sm font-semibold text-base-content">Partner impact report</h3>
                    <div class="mt-2 flex items-center justify-between text-xs text-base-content/55">
                      <span>Peter Mark</span>
                      <span>5 days ago</span>
                    </div>
                  </div>
                </article>
                <article class="overflow-hidden rounded-xl border border-base-300 bg-base-100">
                  <img class="h-24 w-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBCvBkaw-k1g5q16D-8Lyg63sSPOh6kikpEJdMIv31TwTDcIMsDE4imZwq819BnUqSN10RcXzmPZwObVTFANVxsIUGXIC2K_HFyOL3usrN7GsoSIm7DDSyPsGXvAXLvZLMVn51sYNKrs66JRIKSehmE7pNf2KGdEBe5PFxIr3ILe-EloAN_zfyDBkVC4ltaJ_hx9gq7QC__bsj8f-TZZt0kH5KPfmmk0XHYX47XnWZ3ylb9y8Mg_otZVsmv30-XwaqbHaW2YbOk57Q" alt="Calendar launch" />
                  <div class="p-3">
                    <h3 class="line-clamp-1 text-sm font-semibold text-base-content">Zen campaign calendar</h3>
                    <div class="mt-2 flex items-center justify-between text-xs text-base-content/55">
                      <span>Shaun Shanks</span>
                      <span>5 days ago</span>
                    </div>
                  </div>
                </article>
                <article class="overflow-hidden rounded-xl border border-base-300 bg-base-100">
                  <img class="h-24 w-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDoSR5DnYyplH_fEp_QMAxIAwztQp27bg-7Nrk9yw9gWdxy7JoTYrK13KB0pGaiKte44FzRjwhn-BFUUOPqSgsI5-OnpXz3VGSBr3BGX6gmANZMYeH-gWRFiDtBGPqh1ARc1tDDEi1Dl79QAuQxxXARCOLRowXJlErdEjHju2fLhqg_JfP5ky1MepVaYZbELZ23omuT_EsutFNnhYTlmFWl_mVGeIkSnhPgvNoAfSexkYeoe9Wz88vJYKeDl2iJLNUGcbLJ5sodTEM" alt="Product launch" />
                  <div class="p-3">
                    <h3 class="line-clamp-1 text-sm font-semibold text-base-content">Ground breaking launch kit</h3>
                    <div class="mt-2 flex items-center justify-between text-xs text-base-content/55">
                      <span>Jack Luffy</span>
                      <span>5 days ago</span>
                    </div>
                  </div>
                </article>
              </div>
            </div>
          </section>

          <section class="grid gap-4 sm:grid-cols-2">
            <article class="partners-glass-card p-5">
              <h3 class="text-xl font-semibold text-base-content">Forms and Templates</h3>
              <p class="mt-1 text-xs text-base-content/60">Discover and download commonly used partner assets.</p>
              <div class="mt-4 grid grid-cols-2 gap-2">
                <a href="{{ resources_url }}" class="rounded-lg bg-neutral px-3 py-2 text-xs font-medium text-neutral-content transition-opacity hover:opacity-85">Job Description</a>
                <a href="{{ resources_url }}" class="rounded-lg bg-primary px-3 py-2 text-xs font-medium text-primary-content transition-opacity hover:opacity-85">Onboarding</a>
