{% assign insights_url = statics['recent'] | default: '#' %}
{% assign resources_url = statics['resources'] | default: '#' %}
{% assign ecosystem_url = site.index_path | default: '/' %}

<div class="container relative isolate pb-16 pt-8">

  <section
    class="partners-glass-card relative overflow-hidden p-6 sm:p-8"
    style="background-image: linear-gradient(120deg, hsl(var(--theme-color-primary, 173 77% 26%) / 0.06), hsl(var(--theme-color-secondary, 23 83% 42%) / 0.06)), url('{{ 'bg.svg' | asset_url }}'); background-size: cover; background-position: center;"
  >
    <div class="absolute inset-0 bg-base-100/65" aria-hidden="true"></div>
    <div class="relative z-10">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-primary">Partners Portal</p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-base-content sm:text-4xl">Welcome, Sabina</h1>
        <p class="mt-2 text-sm text-base-content/70 sm:text-base">Your ecosystem overview and AI-powered insights are ready.</p>
      </div>
      <nav class="tabs tabs-boxed bg-base-200/70 p-1">
        <a class="tab tab-active" href="{{ statics['dashboard'] | default: '#' }}">Dashboard</a>
        <a class="tab" href="{{ resources_url }}">Resources</a>
        <a class="tab" href="{{ ecosystem_url }}">Ecosystem</a>
      </nav>
    </div>
    {% form_tag 'search' %}
      <div class="mt-6 flex items-center gap-2">
        <label class="input input-bordered flex h-12 flex-1 items-center gap-3 rounded-full border-base-300 bg-base-100/90 px-4 shadow-sm">
          <i data-lucide="search" class="h-4 w-4 text-base-content/60"></i>
          <input
            id="dashboard-ai-search"
            type="text"
            name="{{ form.keywords_field_name }}"
            value="{{ search.keywords | escape_once }}"
            class="grow bg-transparent"
            placeholder="Ask AI anything about your partners..."
          />
          <kbd class="hidden rounded-md border border-base-300 bg-base-200 px-2 py-0.5 text-xs text-base-content/60 sm:inline-flex">⌘ K</kbd>
        </label>
        <button type="submit" class="btn btn-primary btn-sm rounded-full px-4">
          <i data-lucide="search" class="h-4 w-4"></i>
        </button>
      </div>
    {% endform_tag %}
    </div>
  </section>

  <main class="mt-6 gap-6">
    <div class="space-y-6">
      <section class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-7">
        <a class="group relative overflow-hidden rounded-2xl border border-base-300/70 bg-gradient-to-br from-base-100 via-base-100 to-primary/5 p-4 text-left transition-all duration-300 hover:-translate-y-1 hover:border-primary/50 hover:shadow-[0_10px_30px_rgb(15,23,42,0.12)]" href="{{ insights_url }}">
          <div class="absolute -right-5 -top-5 h-16 w-16 rounded-full bg-primary/10 blur-xl" aria-hidden="true"></div>
          <div class="relative flex items-center justify-between">
            <span class="inline-flex rounded-xl bg-primary/12 p-2 text-primary ring-1 ring-primary/20"><i data-lucide="newspaper" class="h-4 w-4"></i></span>
            <i data-lucide="arrow-up-right" class="h-3.5 w-3.5 text-base-content/40 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-primary"></i>
          </div>
          <p class="relative mt-3 text-xs font-semibold tracking-wide text-base-content/85">News</p>
        </a>

        <a class="group relative overflow-hidden rounded-2xl border border-base-300/70 bg-gradient-to-br from-base-100 via-base-100 to-primary/5 p-4 text-left transition-all duration-300 hover:-translate-y-1 hover:border-primary/50 hover:shadow-[0_10px_30px_rgb(15,23,42,0.12)]" href="{{ resources_url }}">
          <div class="absolute -right-5 -top-5 h-16 w-16 rounded-full bg-primary/10 blur-xl" aria-hidden="true"></div>
          <div class="relative flex items-center justify-between">
            <span class="inline-flex rounded-xl bg-primary/12 p-2 text-primary ring-1 ring-primary/20"><i data-lucide="file-text" class="h-4 w-4"></i></span>
            <i data-lucide="arrow-up-right" class="h-3.5 w-3.5 text-base-content/40 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-primary"></i>
          </div>
          <p class="relative mt-3 text-xs font-semibold tracking-wide text-base-content/85">Docs</p>
        </a>

        <a class="group relative overflow-hidden rounded-2xl border border-base-300/70 bg-gradient-to-br from-base-100 via-base-100 to-primary/5 p-4 text-left transition-all duration-300 hover:-translate-y-1 hover:border-primary/50 hover:shadow-[0_10px_30px_rgb(15,23,42,0.12)]" href="{{ insights_url }}">
          <div class="absolute -right-5 -top-5 h-16 w-16 rounded-full bg-primary/10 blur-xl" aria-hidden="true"></div>
          <div class="relative flex items-center justify-between">
            <span class="inline-flex rounded-xl bg-primary/12 p-2 text-primary ring-1 ring-primary/20"><i data-lucide="calendar-days" class="h-4 w-4"></i></span>
            <i data-lucide="arrow-up-right" class="h-3.5 w-3.5 text-base-content/40 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-primary"></i>
          </div>
          <p class="relative mt-3 text-xs font-semibold tracking-wide text-base-content/85">Events</p>
        </a>

        <a class="group relative overflow-hidden rounded-2xl border border-base-300/70 bg-gradient-to-br from-base-100 via-base-100 to-primary/5 p-4 text-left transition-all duration-300 hover:-translate-y-1 hover:border-primary/50 hover:shadow-[0_10px_30px_rgb(15,23,42,0.12)]" href="{{ resources_url }}">
          <div class="absolute -right-5 -top-5 h-16 w-16 rounded-full bg-primary/10 blur-xl" aria-hidden="true"></div>
          <div class="relative flex items-center justify-between">
            <span class="inline-flex rounded-xl bg-primary/12 p-2 text-primary ring-1 ring-primary/20"><i data-lucide="package" class="h-4 w-4"></i></span>
            <i data-lucide="arrow-up-right" class="h-3.5 w-3.5 text-base-content/40 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-primary"></i>
          </div>
          <p class="relative mt-3 text-xs font-semibold tracking-wide text-base-content/85">Products</p>
        </a>

        <a class="group relative overflow-hidden rounded-2xl border border-base-300/70 bg-gradient-to-br from-base-100 via-base-100 to-primary/5 p-4 text-left transition-all duration-300 hover:-translate-y-1 hover:border-primary/50 hover:shadow-[0_10px_30px_rgb(15,23,42,0.12)]" href="{{ resources_url }}">
          <div class="absolute -right-5 -top-5 h-16 w-16 rounded-full bg-primary/10 blur-xl" aria-hidden="true"></div>
          <div class="relative flex items-center justify-between">
            <span class="inline-flex rounded-xl bg-primary/12 p-2 text-primary ring-1 ring-primary/20"><i data-lucide="badge-check" class="h-4 w-4"></i></span>
            <i data-lucide="arrow-up-right" class="h-3.5 w-3.5 text-base-content/40 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-primary"></i>
          </div>
          <p class="relative mt-3 text-xs font-semibold tracking-wide text-base-content/85">Cases</p>
        </a>

        <a class="group relative overflow-hidden rounded-2xl border border-base-300/70 bg-gradient-to-br from-base-100 via-base-100 to-primary/5 p-4 text-left transition-all duration-300 hover:-translate-y-1 hover:border-primary/50 hover:shadow-[0_10px_30px_rgb(15,23,42,0.12)]" href="{{ resources_url }}">
          <div class="absolute -right-5 -top-5 h-16 w-16 rounded-full bg-primary/10 blur-xl" aria-hidden="true"></div>
          <div class="relative flex items-center justify-between">
            <span class="inline-flex rounded-xl bg-primary/12 p-2 text-primary ring-1 ring-primary/20"><i data-lucide="wrench" class="h-4 w-4"></i></span>
            <i data-lucide="arrow-up-right" class="h-3.5 w-3.5 text-base-content/40 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-primary"></i>
          </div>
          <p class="relative mt-3 text-xs font-semibold tracking-wide text-base-content/85">Tools</p>
        </a>

        <a class="group relative overflow-hidden rounded-2xl border border-base-300/70 bg-gradient-to-br from-base-100 via-base-100 to-primary/5 p-4 text-left transition-all duration-300 hover:-translate-y-1 hover:border-primary/50 hover:shadow-[0_10px_30px_rgb(15,23,42,0.12)]" href="{{ resources_url }}">
          <div class="absolute -right-5 -top-5 h-16 w-16 rounded-full bg-primary/10 blur-xl" aria-hidden="true"></div>
          <div class="relative flex items-center justify-between">
            <span class="inline-flex rounded-xl bg-primary/12 p-2 text-primary ring-1 ring-primary/20"><i data-lucide="graduation-cap" class="h-4 w-4"></i></span>
            <i data-lucide="arrow-up-right" class="h-3.5 w-3.5 text-base-content/40 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-primary"></i>
          </div>
          <p class="relative mt-3 text-xs font-semibold tracking-wide text-base-content/85">Learning</p>
        </a>
      </section>

      <section class="grid gap-6 lg:grid-cols-12">
        <div class="space-y-6 lg:col-span-8">
          <section class="partners-glass-card p-5 sm:p-6">
            <div class="flex items-center justify-between">
              <h2 class="text-xl font-semibold text-base-content">How To?</h2>
              <a href="{{ resources_url }}" class="text-sm font-medium text-primary hover:underline">View Guides</a>
            </div>
            <div class="mt-4 grid gap-2 sm:grid-cols-3">
              <a href="{{ resources_url }}" class="rounded-xl border border-base-300 bg-base-100 px-3 py-2 text-xs text-base-content/80 transition-colors hover:border-primary/40 hover:bg-primary/5">Reset Okta credentials?</a>
              <a href="{{ resources_url }}" class="rounded-xl border border-base-300 bg-base-100 px-3 py-2 text-xs text-base-content/80 transition-colors hover:border-primary/40 hover:bg-primary/5">Request Summer Camp ID Card</a>
              <a href="{{ resources_url }}" class="rounded-xl border border-base-300 bg-base-100 px-3 py-2 text-xs text-base-content/80 transition-colors hover:border-primary/40 hover:bg-primary/5">Set up mail forwarding</a>
              <a href="{{ resources_url }}" class="rounded-xl border border-base-300 bg-base-100 px-3 py-2 text-xs text-base-content/80 transition-colors hover:border-primary/40 hover:bg-primary/5">Request lock up an EID?</a>
              <a href="{{ resources_url }}" class="rounded-xl border border-base-300 bg-base-100 px-3 py-2 text-xs text-base-content/80 transition-colors hover:border-primary/40 hover:bg-primary/5">Request a new account?</a>
              <a href="{{ resources_url }}" class="rounded-xl border border-base-300 bg-base-100 px-3 py-2 text-xs text-base-content/80 transition-colors hover:border-primary/40 hover:bg-primary/5">Microsoft outlook issues</a>
              <a href="{{ resources_url }}" class="rounded-xl border border-base-300 bg-base-100 px-3 py-2 text-xs text-base-content/80 transition-colors hover:border-primary/40 hover:bg-primary/5">Report a software issue?</a>
              <a href="{{ resources_url }}" class="rounded-xl border border-base-300 bg-base-100 px-3 py-2 text-xs text-base-content/80 transition-colors hover:border-primary/40 hover:bg-primary/5">Set up a home network router?</a>
              <a href="{{ resources_url }}" class="rounded-xl border border-base-300 bg-base-100 px-3 py-2 text-xs text-base-content/80 transition-colors hover:border-primary/40 hover:bg-primary/5">Set up a home broadband router?</a>
            </div>

            <div class="mt-6 border-t border-base-300/80 pt-5">
              <div class="flex items-center justify-between">
