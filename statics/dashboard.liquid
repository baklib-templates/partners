                <a href="{{ resources_url }}" class="btn btn-ghost btn-sm text-primary">View All</a>
              </div>
              <div class="mt-3 grid gap-3 sm:grid-cols-3">
                <article class="overflow-hidden rounded-xl border border-base-300 bg-base-100">
