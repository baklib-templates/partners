{% assign dashboard_url = statics['dashboard'] | default: '#' %}
{% assign resources_url = statics['resources'] | default: '#' %}
{% assign ecosystem_url = site.index_path | default: '/' %}

<div class="container relative isolate pb-16 pt-8">
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <div class="absolute -left-1/4 top-6 h-72 w-72 rounded-full bg-primary/20 blur-3xl"></div>
    <div class="absolute -right-1/4 top-1/3 h-72 w-72 rounded-full bg-secondary/15 blur-3xl"></div>
  </div>

  <section class="partners-glass-card p-6 sm:p-8">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-primary">Partners Portal</p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-base-content sm:text-4xl">Resource Library</h1>
        <p class="mt-2 max-w-3xl text-sm text-base-content/70 sm:text-base">
          Access partner assets, technical documents, brand materials, and strategic toolkits to accelerate your ecosystem operations.
        </p>
      </div>
      <nav class="tabs tabs-boxed bg-base-200/70 p-1">
        <a class="tab" href="{{ dashboard_url }}">Dashboard</a>
        <a class="tab tab-active" href="{{ resources_url }}">Resources</a>
        <a class="tab" href="{{ ecosystem_url }}">Ecosystem</a>
      </nav>
    </div>
  </section>

  <main class="mt-6 space-y-6">
    <section class="partners-glass-card p-4 sm:p-5">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
        <label class="input input-bordered h-11 w-full border-base-300 bg-base-100 lg:max-w-sm">
          <i data-lucide="search" class="h-4 w-4 text-base-content/50"></i>
          <input id="resources-search" type="text" class="grow" placeholder="Search resources..." />
        </label>
        <div class="flex flex-wrap gap-2" id="resource-filter-group">
          <button type="button" data-filter="all" class="resource-filter-chip btn btn-sm border-0 bg-primary text-primary-content shadow-sm">All Resources</button>
          <button type="button" data-filter="whitepapers" class="resource-filter-chip btn btn-soft btn-sm">Whitepapers</button>
          <button type="button" data-filter="asset-packs" class="resource-filter-chip btn btn-soft btn-sm">Asset Packs</button>
          <button type="button" data-filter="case-studies" class="resource-filter-chip btn btn-soft btn-sm">Case Studies</button>
          <button type="button" data-filter="technical-guides" class="resource-filter-chip btn btn-soft btn-sm">Technical Guides</button>
        </div>
      </div>
    </section>

    <section class="partners-glass-card overflow-hidden p-0">
      <div class="relative h-72 sm:h-80">
        <img
          class="h-full w-full object-cover"
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuBemTICPt9LpE-zemXL5daxmJCRtRP6wMXVKXLmJcZZatAFTvOOl82HKrzaomvRA9_aIlq7SSZD02amFdphvyuix5iUwPIULskiWpVRbJFbU_gkYKB-8CHoTI0BI_oLg25pRh3fNvmbLXkiWnFBT8CNSEWMZOfha3zaiFTkxj9z6ufo2Sksfugqy_xFN2vaZEVW7oOwxGfbLVKRV7K1Gpi1iCh7Y3NjeY0g_6odQjagbf7jcZbFFKrEiO1VDheSOi1pxaRH5_-L2TU"
          alt="Featured ecosystem strategy guide"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-neutral/75 via-neutral/35 to-transparent"></div>
        <div class="absolute bottom-0 left-0 max-w-3xl p-6 text-neutral-content sm:p-8">
          <span class="badge badge-info badge-sm border-0 text-info-content">
            <i data-lucide="sparkles" class="mr-1 h-3 w-3"></i>
            Featured Resource
          </span>
          <h2 class="mt-3 text-2xl font-semibold sm:text-3xl">2024 Partner Ecosystem Strategy Guide</h2>
          <p class="mt-2 text-sm text-neutral-content/85 sm:text-base">
            Explore the foundational pillars of resilient AI-first partnership models, from technical orchestration to market alignment execution.
          </p>
          <a href="{{ resources_url }}" class="btn btn-primary mt-5 border-0 shadow-sm">
            <i data-lucide="download" class="h-4 w-4"></i>
            Download Guide (12.4 MB)
          </a>
        </div>
      </div>
    </section>

    <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      <article class="partners-glass-card flex h-full flex-col p-5">
        <div class="mb-4 flex items-start justify-between gap-3">
          <div class="inline-flex rounded-lg bg-primary/10 p-2 text-primary ring-1 ring-primary/20">
            <i data-lucide="file-text" class="h-5 w-5"></i>
          </div>
          <span class="text-xs font-medium uppercase tracking-wide text-base-content/55">PDF · 4.2 MB</span>
        </div>
        <h3 class="text-lg font-semibold text-base-content">AI Implementation Toolkit</h3>
        <p class="mt-2 flex-1 text-sm text-base-content/70">
          Step-by-step framework for deploying LLM workflows within partner infrastructures efficiently.
        </p>
        <div class="mt-4 flex items-center justify-between">
          <span class="text-xs text-base-content/55">Updated: Oct 24, 2024</span>
          <a href="{{ resources_url }}" class="btn btn-ghost btn-xs text-primary"><i data-lucide="download" class="h-4 w-4"></i></a>
        </div>
      </article>

      <article class="partners-glass-card flex h-full flex-col p-5">
        <div class="mb-4 flex items-start justify-between gap-3">
          <div class="inline-flex rounded-lg bg-secondary/15 p-2 text-secondary ring-1 ring-secondary/25">
            <i data-lucide="folder-archive" class="h-5 w-5"></i>
          </div>
          <span class="text-xs font-medium uppercase tracking-wide text-base-content/55">ZIP · 128 MB</span>
        </div>
        <h3 class="text-lg font-semibold text-base-content">Q4 Marketing Asset Pack</h3>
        <p class="mt-2 flex-1 text-sm text-base-content/70">
          Brand visuals, campaign templates, and co-marketing assets prepared for partner launches.
        </p>
        <div class="mt-4 flex items-center justify-between">
          <span class="text-xs text-base-content/55">Updated: Oct 15, 2024</span>
          <a href="{{ resources_url }}" class="btn btn-ghost btn-xs text-primary"><i data-lucide="download" class="h-4 w-4"></i></a>
        </div>
      </article>

      <article class="partners-glass-card flex h-full flex-col p-5">
        <div class="mb-4 flex items-start justify-between gap-3">
          <div class="inline-flex rounded-lg bg-info/15 p-2 text-info ring-1 ring-info/25">
            <i data-lucide="file-badge" class="h-5 w-5"></i>
          </div>
          <span class="text-xs font-medium uppercase tracking-wide text-base-content/55">DOCX · 1.1 MB</span>
        </div>
        <h3 class="text-lg font-semibold text-base-content">Service Level Agreement (v2.1)</h3>
        <p class="mt-2 flex-1 text-sm text-base-content/70">
          Updated compliance and performance standards for premium ecosystem partners.
        </p>
        <div class="mt-4 flex items-center justify-between">
          <span class="text-xs text-base-content/55">Updated: Oct 02, 2024</span>
          <a href="{{ resources_url }}" class="btn btn-ghost btn-xs text-primary"><i data-lucide="download" class="h-4 w-4"></i></a>
        </div>
      </article>

      <article class="partners-glass-card flex h-full flex-col p-5">
        <div class="mb-4 flex items-start justify-between gap-3">
          <div class="inline-flex rounded-lg bg-success/15 p-2 text-success ring-1 ring-success/25">
            <i data-lucide="chart-column-big" class="h-5 w-5"></i>
          </div>
          <span class="text-xs font-medium uppercase tracking-wide text-base-content/55">PDF · 8.5 MB</span>
        </div>
        <h3 class="text-lg font-semibold text-base-content">Market Insights: AI Trends</h3>
        <p class="mt-2 flex-1 text-sm text-base-content/70">
          Vertical adoption intelligence and 2025 growth opportunities for regional partner teams.
        </p>
        <div class="mt-4 flex items-center justify-between">
          <span class="text-xs text-base-content/55">Updated: Sep 28, 2024</span>
          <a href="{{ resources_url }}" class="btn btn-ghost btn-xs text-primary"><i data-lucide="download" class="h-4 w-4"></i></a>
        </div>
      </article>

      <article class="partners-glass-card flex h-full flex-col p-5">
        <div class="mb-4 flex items-start justify-between gap-3">
          <div class="inline-flex rounded-lg bg-warning/25 p-2 text-warning-content ring-1 ring-warning/40">
            <i data-lucide="presentation" class="h-5 w-5"></i>
          </div>
          <span class="text-xs font-medium uppercase tracking-wide text-base-content/55">PPTX · 18.3 MB</span>
        </div>
        <h3 class="text-lg font-semibold text-base-content">Partner Pitch Deck 2.0</h3>
        <p class="mt-2 flex-1 text-sm text-base-content/70">
          Editable deck template for positioning PartnerIntel AI to enterprise prospects.
        </p>
        <div class="mt-4 flex items-center justify-between">
          <span class="text-xs text-base-content/55">Updated: Sep 20, 2024</span>
          <a href="{{ resources_url }}" class="btn btn-ghost btn-xs text-primary"><i data-lucide="download" class="h-4 w-4"></i></a>
        </div>
      </article>

      <article class="partners-glass-card flex h-full flex-col p-5">
        <div class="mb-4 flex items-start justify-between gap-3">
          <div class="inline-flex rounded-lg bg-accent/15 p-2 text-accent ring-1 ring-accent/25">
            <i data-lucide="terminal-square" class="h-5 w-5"></i>
          </div>
          <span class="text-xs font-medium uppercase tracking-wide text-base-content/55">JSON · 2.4 MB</span>
        </div>
        <h3 class="text-lg font-semibold text-base-content">API Documentation Bundle</h3>
        <p class="mt-2 flex-1 text-sm text-base-content/70">
          Developer package including Postman collections and integration schema files.
        </p>
        <div class="mt-4 flex items-center justify-between">
          <span class="text-xs text-base-content/55">Updated: Sep 12, 2024</span>
          <a href="{{ resources_url }}" class="btn btn-ghost btn-xs text-primary"><i data-lucide="download" class="h-4 w-4"></i></a>
        </div>
      </article>
    </section>

    <section class="partners-glass-card flex flex-col items-center justify-center gap-6 p-6">
      <div class="join">
        <button class="join-item btn btn-sm btn-ghost text-base-content/60"><i data-lucide="chevron-left" class="h-4 w-4"></i></button>
        <button class="join-item btn btn-sm border-0 bg-primary text-primary-content">1</button>
        <button class="join-item btn btn-sm btn-ghost">2</button>
        <button class="join-item btn btn-sm btn-ghost">3</button>
        <button class="join-item btn btn-sm btn-ghost">...</button>
        <button class="join-item btn btn-sm btn-ghost">12</button>
        <button class="join-item btn btn-sm btn-ghost text-base-content/60"><i data-lucide="chevron-right" class="h-4 w-4"></i></button>
      </div>
    </section>
  </main>
</div>

<script>
  (function () {
    const chipSelector = ".resource-filter-chip";
    const activeClasses = ["bg-primary", "text-primary-content", "border-0", "shadow-sm"];
    const normalClasses = ["btn-soft", "bg-base-200", "text-base-content"];
    const chips = document.querySelectorAll(chipSelector);

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        chips.forEach((item) => {
          item.classList.remove(...activeClasses);
          item.classList.add(...normalClasses);
        });
        chip.classList.remove(...normalClasses);
        chip.classList.add(...activeClasses);
      });
    });

    document.addEventListener("keydown", (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        const input = document.getElementById("resources-search");
        if (input) input.focus();
      }
    });
  })();
</script>