{% layout false %}
{% assign pages = site.pages['/'].children_in_list | order_by: '-created_at' | limit: 5 %}

<!DOCTYPE html>
<html lang="{{ site.language }}">
  <head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="author" content="Baklib">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% meta_tags %}
    {{ 'stylesheets/application.css' | asset_url | stylesheet_tag: data-turbo-track: 'reload' }}
    {{ 'baklib/shared/main.css' | asset_url | stylesheet_tag: data-turbo-track: 'reload' }}
    {{ 'baklib/shared/main.js' | asset_url | stylesheet_tag: data-turbo-track: 'reload' }}
    {{ 'javascripts/application.js' | asset_url | script_tag: defer: true, data-turbo-track: 'reload' }}
    {%# TIPS: Uncomment the next line for low-code platform development %}
    {% if false %} {{ 'javascripts/cdn.tailwindcss.js' | asset_url | script_tag: data-turbo-track: 'reload' }} {% endif %}
    {{ site.settings.head_html }}
  </head>

  <body class="relative min-h-screen font-sans text-base-content">
    <div class="relative flex flex-col min-h-screen overflow-hidden supports-[overflow:clip]:overflow-clip">
      <!-- Grid background -->
      <div class="absolute inset-y-0 w-[1102px] left-1/2 -translate-x-1/2 -z-10 pointer-events-none blur-3xl"
        aria-hidden="true">
        <div
          class="absolute w-[960px] h-24 top-12 animate-[swing_8s_ease-in-out_infinite] before:absolute before:inset-0 before:rounded-tl-full before:rounded-br-full before:bg-gradient-to-b before:from-transparent before:to-transparent before:via-primary before:-rotate-[42deg]">
        </div>
        <div
          class="absolute w-[960px] h-24 -top-12 -left-28 animate-[swing_15s_-1s_ease-in-out_infinite] before:absolute before:inset-0 before:rounded-tl-full before:rounded-br-full before:bg-gradient-to-b before:from-transparent before:to-transparent before:via-primary/60 before:-rotate-[42deg]">
        </div>
        <div
          class="absolute w-[960px] h-16 top-36 left-80 animate-[swing_7s_-2s_ease-in-out_infinite] before:absolute before:inset-0 before:rounded-tl-full before:rounded-br-full before:bg-gradient-to-b before:from-transparent before:to-transparent before:via-primary/60 before:-rotate-[42deg]">
        </div>
        <div
          class="absolute w-[960px] h-64 top-[820px] left-44 animate-[swing_10s_ease-in-out_infinite] before:absolute before:inset-0 before:rounded-tl-full before:rounded-br-full before:bg-gradient-to-b before:from-transparent before:to-transparent before:via-primary/30 before:-rotate-[42deg]">
        </div>
        <div
          class="absolute w-[480px] h-12 top-[970px] left-[550px] animate-[swing_15s_-2s_ease-in-out_infinite] before:absolute before:inset-0 before:rounded-tl-full before:rounded-br-full before:bg-gradient-to-b before:from-transparent before:to-transparent before:via-primary/45 before:-rotate-[42deg]">
        </div>
        <div
          class="absolute w-[960px] h-16 top-[820px] left-24 animate-[swing_9s_-3s_ease-in-out_infinite] before:absolute before:inset-0 before:rounded-tl-full before:rounded-br-full before:bg-gradient-to-b before:from-transparent before:to-transparent before:via-primary/45 before:-rotate-[42deg]">
        </div>
      </div>

      <!-- Top navigation -->
      <div class="flex relative z-10 justify-between items-center px-8 pt-8">
        <a href="/" class="flex items-center text-xs tracking-widest text-base-content/60 transition hover:text-base-content">
          <span class="mr-2">&larr;</span> {{ 'generic.back_to_home' | t }}
        </a>
      </div>

      <!-- Main content -->
      <div class="flex relative z-10 flex-col items-center mt-12">
        <div class="flex flex-col items-center">
          <h1 class="mb-2 text-4xl font-extrabold tracking-tight text-base-content">{{ 'generic.recent_updates' | t }}</h1>
        </div>
      </div>

      <div class="overflow-visible pb-4 h-auto min-h-screen">
        <div class="container relative flex flex-col pt-[150px] sm:flex-row sm:space-x-2">
          <div class="w-full space-y-2 lg:space-y-4 -mt-[60px]">
              {% for page in pages %}
                {% comment %} Card-style media list rendering {% endcomment %}
                <article class="block w-full break-all rounded-lg bg-base-100 p-4 shadow">
                  <div class="flex items-center space-x-2 text-xs font-light shrink-0">
                    {%- if page.published_at -%}
                      <div class="flex items-center space-x-1 text-base-content/50">
                        <i data-lucide="calendar-clock" class="h-4 w-4"></i>
                        <span class="flex justify-center items-center font-mono text-xs">{{ page.published_at | date: "%Y-%m-%d" }}</span>
                      </div>
                    {%- endif -%}

                    {% for tag in page.settings.tags %}
                      <a href="{{ tag.path }}" style="background-color: {{ tag.color }}" class="px-2 py-1 text-xs text-white rounded-md focus:outline-none focus:ring-2 focus:ring-offset-2">
                        {{ tag.name }}
                      </a>
                    {% endfor %}
                  </div>
                  {% assign thumb_image_url = page.settings.thumb_image_url | presence %}
                  {%- if thumb_image_url -%}
                    <div class="overflow-hidden rounded-lg bg-primary/10">
                      <a href="{{ page.path }}" class="block">
                        <img class="w-full transition-all duration-500 ease-in-out scale-100 hover:scale-110" src="{{ thumb_image_url }}" />
                      </a>
                    </div>
                  {%- endif  -%}
                  <h2 class="my-3 text-lg font-bold text-base-content hover:underline md:text-2xl">
                    <a href="{{ page.path }}">{{ page.link_text }}</a>
                  </h2>

                  {% if page.settings.description %}
                    <p class="mt-6 leading-normal text-base-content/70">{{ page.settings.description }}</p>
                  {% endif  %}

                  {%- render "sub_page_list", page: page -%}
                </article>
              {% else %}
                {{ 'generic.empty' | t }}
              {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </body>
</html>

