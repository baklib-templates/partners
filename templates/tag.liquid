  <div class="container flex h-full overflow-visible py-2 md:space-x-2">
    <div class="flex min-h-[calc(100vh-200px)] flex-1 flex-col space-y-4">
      <!-- tag name -->
      <div class="rounded-lg shadow" style="--bg-color: hsl({{ tag.color_hls[0] }}, {{ tag.color_hls[1] }}%, 95%); --color: {{ tag.color }}">
        <div class="h-5 rounded-t-lg bg-[var(--color)]"></div>
        <div class="px-3 py-6 text-xl rounded-b-lg bg-[var(--bg-color)]">
          <span class="flex-grow w-0 break-words font-semibold text-[--color]"> # {{ tag.name }}</span>
        </div>
      </div>

      <!-- filters by tag name -->
      <ul role="list" class="space-y-2">
        {% paginate_tag tag.pages, as: 'pages' %}
          {% for page in pages %}
            {% render 'card', page: page %}
          {% else %}
            <div class="flex justify-center rounded-lg bg-base-100 py-24 text-sm">{{ 'generic.empty' | t }}</div>
          {% endfor %}
          {% render 'paginate', paginate: paginate %}
        {% endpaginate_tag %}
      </ul>
    </div>

    <!-- Sidebar Section -->
    <aside class="sticky top-[74px] hidden h-fit w-64 shrink-0 pl-4 sm:block">
      {% render 'sidebar', site: site %}
    </aside>
  </div>

