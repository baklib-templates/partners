<div class="container h-full min-h-screen overflow-visible bg-base-200 py-2">
    {% comment %} search form {% endcomment %}
    <div class="rounded-tl-lg rounded-tr-lg bg-primary p-5 text-primary-content">
      {% form_tag 'search' %}
        <div class="relative flex items-center">
          <input type="text" name="{{form.keywords_field_name}}" value="{{ search.keywords | escape_once }}" class="block w-full rounded border-0 bg-base-100 py-3 pl-2 pr-8 text-sm text-base-content outline-none placeholder:text-base-content/50" placeholder="{{ 'generic.placeholders.search' | t }}" x-init="$nextTick(() => { $el.focus(); $el.setSelectionRange($el.value.length, $el.value.length); })">
        </div>
      {% endform_tag %}
    </div>

    {% if search.keywords or search.tag %}
      {% comment %} Search results {% endcomment %}
      <ul class="list-none space-y-5 overflow-hidden rounded-bl-lg rounded-br-lg bg-base-100 p-2">
        {% if search.page_number == 1 %}
          {% for link in search.extends %}
            <li class="space-y-4 rounded-md bg-accent/10 hover:bg-accent/15 md:p-4">
              <a class="search-highlight-block text-lg font-bold text-base-content hover:text-secondary md:text-xl" href="{{ link.url }}">{{ link.link_text }}</a>
              <p class="search-highlight-block line-clamp-3 text-sm text-base-content/60">{{ link.url }}</p>
            </li>
          {% endfor %}
        {% endif %}
        {% paginate_tag search.pages, as: 'items' %}
          {% for page in items %}
            <li class="group flex items-center space-x-4 rounded border-b border-base-300 px-2 py-2 hover:bg-primary/10">
              <div class="flex-grow w-0">
                <h3 class="truncate group-hover:text-primary text-xl font-semibold">
                  <a href="{{ page.path }}" class="inline-block search-highlight-block">
                    {{ page.highlighted_search_title }}
                  </a>
                </h3>
                <p class="search-highlight-block my-1 line-clamp-3 px-2 text-base-content/60">
                  {{ page.highlighted_search_content }}
                </p>
              </div>
              <span class="flex-shrink-0 inline-block w-0 h-0 border-[5px] border-l-primary border-t-transparent border-r-transparent border-b-transparent"></span>
            </li>
          {% else %}
            <div class="flex items-center justify-center py-24 text-sm">
              {{ "generic.empty" | t }}
            </div
          {% endfor %}
          {% render 'paginate', paginate: paginate %}
        {% endpaginate_tag %}
      </ul>
    {% else %}
      <div class="w-full mx-auto my-8">{{ "generic.empty" | t }}</div>
    {% endif %}
</div>